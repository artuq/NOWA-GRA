{
  "description": "CCGS lifecycle and validation hooks adapted for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 10,
            "statusMessage": "Loading CCGS session context",
            "additionalContextLimit": 5000
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/detect-gaps.sh\"",
            "timeout": 10,
            "statusMessage": "Checking CCGS documentation gaps",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/validate-commit.sh\"",
            "timeout": 15,
            "statusMessage": "Validating commit"
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/validate-push.sh\"",
            "timeout": 10,
            "statusMessage": "Validating push"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/validate-assets.sh\"",
            "timeout": 10,
            "statusMessage": "Validating changed assets"
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/validate-skill-change.sh\"",
            "timeout": 5,
            "statusMessage": "Checking changed skills"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/pre-compact.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/post-compact.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/session-stop.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/log-agent.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/log-agent-stop.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
