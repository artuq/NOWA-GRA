<Project Sdk="Godot.NET.Sdk/4.6.3">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Must match project.godot's dotnet/project/assembly_name or Godot loads no C# assembly. -->
    <AssemblyName>King of Cringe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- gdUnit4's own bundled C# test fixtures are for its internal CI only.
         This project uses gdUnit4's GDScript side exclusively (no GdUnit4Net
         reference), so these must not be compiled into our assembly. -->
    <Compile Remove="addons/gdUnit4/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="com.IvanMurzak.ReflectorNet" Version="5.3.2" />
    <PackageReference Include="com.IvanMurzak.McpPlugin" Version="7.2.0" />
  <PackageReference Include="com.IvanMurzak.Godot.MCP.Particles" Version="*" /><PackageReference Include="com.IvanMurzak.Godot.MCP.Tilemap" Version="*" /><PackageReference Include="com.IvanMurzak.Godot.MCP.Navigation" Version="*" /><PackageReference Include="com.IvanMurzak.Godot.MCP.Animation" Version="*" /><PackageReference Include="com.IvanMurzak.Godot.MCP.CSG" Version="*" /><PackageReference Include="com.IvanMurzak.Godot.MCP.GridMap" Version="*" /><PackageReference Include="com.IvanMurzak.Godot.MCP.Beehave" Version="*" /><PackageReference Include="com.IvanMurzak.Godot.MCP.PhantomCamera" Version="*" /><PackageReference Include="com.IvanMurzak.Godot.MCP.Dialogic" Version="*" /><PackageReference Include="com.IvanMurzak.Godot.MCP.Terrain3D" Version="*" /></ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="addons/godot_mcp/extensions.catalog.json" LogicalName="Godot-MCP.extensions.catalog.json" />
  </ItemGroup>
</Project>
