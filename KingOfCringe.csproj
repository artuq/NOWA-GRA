<Project Sdk="Godot.NET.Sdk/4.6.3">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- gdUnit4's own bundled C# test fixtures are for its internal CI only.
         This project uses gdUnit4's GDScript side exclusively (no GdUnit4Net
         reference), so these must not be compiled into our assembly. -->
    <Compile Remove="addons/gdUnit4/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="com.IvanMurzak.ReflectorNet" Version="5.3.2" />
    <PackageReference Include="com.IvanMurzak.McpPlugin" Version="7.1.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="addons/godot_mcp/extensions.catalog.json"
      LogicalName="Godot-MCP.extensions.catalog.json" />
  </ItemGroup>
</Project>
