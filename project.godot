; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="King of Cringe"
run/main_scene="res://scenes/action_screen/action_screen.tscn"
config/features=PackedStringArray("4.6")

[gui]

theme/custom="res://assets/ui/minimal_ui4/MinimalUI.tres"

[autoload]

ResourceManager="*res://src/core/resource_manager.gd"
HistoryFlagManager="*res://src/core/history_flag_manager.gd"
CardContentDatabase="*res://src/core/card_content_database.gd"
SaveSystem="*res://src/core/save_system.gd"
ActionSystem="*res://src/core/action_system.gd"
DecisionCardSystem="*res://src/core/decision_card_system.gd"
OfflineProgressSystem="*res://src/core/offline_progress_system.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")
